# Copy file nay thanh setup/.env roi dien gia tri that.
# Khong gui setup/.env qua kenh khong an toan.

# PostgreSQL (Neon)
# Dang Npgsql key-value (Neon):
# DATABASE_URL=Host=<project>-pooler.<region>.aws.neon.tech; Database=neondb; Username=neondb_owner; Password=<pw>; SSL Mode=VerifyFull; Channel Binding=Require;
# hoac dang URI: DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=Host=your-db-host.neon.tech; Database=neondb; Username=your_user; Password=your_password; SSL Mode=VerifyFull; Channel Binding=Require;

# TLS certificate cho DrawingServer
SERVER_CERT_PATH=server.pfx
SERVER_CERT_PASSWORD=123456

# AI, chi can neu demo AI
HF_TOKEN=your_hugging_face_token_here
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
REMOVE_BG_API_KEY=your_remove_bg_api_key_here

# Nhan dien net ve tay -> line art qua HF Space (Gradio 4, ZeroGPU). De trong HF_SKETCH_SPACE = Space mac dinh.
HF_SKETCH_SPACE=
HF_SKETCH_API=/predict
HF_SKETCH_PROMPT=
HF_SKETCH_NEGATIVE=
HF_SKETCH_FIDELITY=0.6

# Ngrok, chi can tren may LoadBalancer khi demo Internet
NGROK_AUTHTOKEN=

# Client / LoadBalancer defaults
USE_LOAD_BALANCER_ROUTING=1
LOAD_BALANCER_CLIENT_MODE=relay
LOAD_BALANCER_STRATEGY=room-affinity

# Client ket noi LB. 127.0.0.1 nghia la client chay cung may voi LB.
# Khi client Internet qua ngrok, doi thanh host trong endpoint tcp://host:port.
LOAD_BALANCER_HOST=127.0.0.1
LOAD_BALANCER_PORT=9000
LOAD_BALANCER_UDP_PORT=9001
LOAD_BALANCER_UDP_PROXY=0
CLIENT_ALLOW_DIRECT_FALLBACK=0
CLIENT_FORCE_TCP_REALTIME=0
CLIENT_CONNECT_TIMEOUT_MS=6000

# Backend ma LoadBalancer se relay toi. De trong thi script se hoi IP.
# Khi duoc hoi, Enter = 127.0.0.1, nghia la server chay cung may voi LoadBalancer.
# Neu server khac may LAN, nhap IP LAN cua server. Neu khac mang, nhap IP Tailscale.
LB_SERVER_1_HOST=
LB_SERVER_1_TCP_PORT=8888
LB_SERVER_1_UDP_PORT=8889
LB_SERVER_2_HOST=
LB_SERVER_2_TCP_PORT=8890
LB_SERVER_2_UDP_PORT=8891

# Drawing server defaults
SERVER_ID=server-1
SERVER_NAME=DrawingServer-1
SERVER_TCP_PORT=8888
SERVER_UDP_PORT=8889
SERVER_PUBLIC_HOST=127.0.0.1
MAX_ROOM_MEMBERS=5

# Snapshot (xem lai): chu ky chup checkpoint (phut) + so ban giu moi phong
SNAPSHOT_INTERVAL_MINUTES=1
SNAPSHOT_RETAIN_PER_ROOM=20
